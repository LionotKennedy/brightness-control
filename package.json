{
  "name": "brightness-control-responsive",
  "version": "2.0.0",
  "description": "Application de contrôle de luminosité Windows - Responsive Design",
  "main": "main.js",
  "scripts": {
    "start": "cross-env ELECTRON_DISABLE_GPU=1 ELECTRON_DISABLE_HARDWARE_ACCELERATION=1 electron .",
    "start:responsive": "cross-env ELECTRON_ENABLE_LOGGING=1 electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "dist": "electron-builder --win portable"
  },
  "author": "TonNom",
  "license": "MIT",
  "devDependencies": {
    "electron": "^27.3.11",
    "electron-builder": "^24.13.3",
    "cross-env": "^7.0.3"
  },
  "build": {
    "appId": "com.brightness.control.responsive",
    "productName": "Brightness Control Responsive",
    "directories": {
      "output": "dist-responsive"
    },
    "files": [
      "**/*",
      "!node_modules/**/*",
      "!*.log",
      "!*.md",
      "!dist*/"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "asar": true
    },
    "portable": {
      "artifactName": "BrightnessControlResponsive.exe"
    }
  },
  "keywords": ["responsive", "brightness", "control", "electron"]
}